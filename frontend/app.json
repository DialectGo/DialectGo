{
  "expo": {
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "dialectgo",
    "name": "DialectGo",
    "slug": "DialectGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/DialectGo-App-Logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/DialectGo-App-Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDCE4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ralph.dialectgo.app"
    },
    "android": {
      "splash": {
        "image": "./assets/DialectGo-App-Logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FDCE4A"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/DialectGo-App-Logo.png",
        "backgroundColor": "#FDCE4A"
      },
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.ralph.dialectgo.app"
    },
    "web": {
      "favicon": "./assets/DialectGo-App-Logo.png"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "networkInspector": true
          }
        }
      ],
      "./plugins/withNetworkSecurityConfig"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6de09f0b-4eae-4437-a7c5-7d340fd4e4b0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6de09f0b-4eae-4437-a7c5-7d340fd4e4b0",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    }
  }
}
